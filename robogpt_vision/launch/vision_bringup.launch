
<launch>

    <arg name="sim_vision" default="off"/>
    <!-- loading the camera details  -->
    <rosparam command="load" file="$(find robogpt_vision)/config/camera_params.yaml"/>
    <param name="vision_sim" value="$(arg sim_vision)" />
    
    <arg name="comp_name" default="intel"/> <!-- Options : intel, orbec, or zed2i -->
    <param name="comp_name" value="$(arg comp_name)"/>

    <!-- Launching the vision startup node -->
    <node pkg="robogpt_vision" type="vision_startup.py" name="start_vision">    
    </node>


    <node pkg="robogpt_vision" type="get_world_context.py" name="get_world_context_service" output="screen" />
    <node pkg="auto_train_ros" type="auto_train_server.py" name="auto_train_server" output="screen" />

    <!-- Sending the video feed to web pub sub -->
    <node pkg="robogpt_vision" type="web_feed.py" name="web_feed" >    
    </node>

     <!-- Sending the video feed to web pub sub -->
    <node pkg="robogpt_vision" type="feed_mask.py" name="masked_feed" >    
    </node>
    
</launch>