<launch>
  <!-- Define an argument with a default value -->
  <arg name="robot_name" default="sim"/>

  <!-- Use the argument for a parameter -->
  <param name="/robot_model" value="$(arg robot_name)" />

  <!-- Run a node from a package -->
  <node 
      pkg="robogpt_agents" 
      type="prompt.py" 
      name="robogpt_agent_initalizer" 
      output="screen">
  </node>

</launch>
