<launch>
  <!-- Define an argument with a default value -->
  <arg name="robot_name" default="sim"/>
  <arg name="use_case"   default="base"/>
  <arg name="setup" default="janatics"/>
  <arg name="use_sim" default="false"/>
  <!-- Use the argument for a parameter -->
  <param name="/robot_model" value="$(arg robot_name)" />
  <param name="/use_case" value="$(arg use_case)" />
  <param name="/use_sim" value="$(arg use_sim)" />

  <param name="setup" value="$(arg setup)"/>


  <!-- Run  a node from a package -->
  <node 
      pkg="robogpt_agents" 
      type="prompt.py" 
      name="robogpt_agent_initalizer" 
      output="screen">
  </node>

    <!-- Run  a node from a package -->
  <node 
      pkg="robogpt_agents" 
      type="tour_action_server.py" 
      name="tour_server" >
  </node>

</launch>
